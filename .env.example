# Documentation only: export these variables in the shell.
DATA_DIR=./data
# Bytes; default is 20 MiB.
MAX_UPLOAD_SIZE=20971520
# Checked before loading pages; allows documents with more than 400 pages.
MAX_PDF_PAGES=1000
# Cooperative seconds after acquiring the PDF lock; not a hard native timeout.
MAX_PDF_ANALYSIS_SECONDS=60
